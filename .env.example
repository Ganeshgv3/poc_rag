# Optional: use a single env file from elsewhere (loaded first; poc_rag/.env still overrides if present)
# DOTENV_PATH=/var/www/php83-app/rag/.env

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=rag_app
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=120
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Conversation context memory for Ollama (prior user/assistant turns + current RAG message)
# CONTEXT_MEMORY_ENABLED=true
# CONTEXT_MEMORY_MAX_MESSAGES=40

# PDF chunking for indexing (optional tuning)
# PDF_CHUNK_SIZE=1100
# PDF_CHUNK_OVERLAP=180

# Vector store: chroma (default) or qdrant
# VECTOR_BACKEND=chroma
# Local Chroma on disk: data/chroma (default when VECTOR_BACKEND unset)
# Optional: remote Chroma server (REST on port 8000 by default — not Qdrant)
# CHROMA_URL=http://127.0.0.1:8000

# Qdrant (REST API / dashboard typically on port 6333)
# VECTOR_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
# Optional: QDRANT_API_KEY=

# Hybrid retrieval (dense embeddings + BM25, fused with RRF). Requires rank-bm25.
# HYBRID_SEARCH_ENABLED=true
# HYBRID_RRF_K=60
# HYBRID_DENSE_POOL=24
# HYBRID_SPARSE_POOL=40
# HYBRID_MAX_TOTAL_CHUNKS=12000

# Optional: LangSmith tracing for LangChain / LangGraph (https://smith.langchain.com)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

# Agentic RAG: after first retrieval, a small LLM pass judges coverage; if weak, 1–2 follow-up
# hybrid searches run and chunks merge (deduped) before answer generation. Extra Ollama call when enabled.
# AGENTIC_RAG_ENABLED=false
# AGENTIC_RAG_MERGED_CAP=12
# AGENTIC_RAG_MAX_FOLLOWUP_QUERIES=2
# AGENTIC_RAG_GRADER_NUM_PREDICT=220

# RAG answer generation (API + LangGraph LLM path). Low temperature improves repeatability for PDF QA.
# RAG_CHAT_TEMPERATURE=0.0
# RAG_CHAT_NUM_PREDICT=320

# DeepEval judge via Amazon Bedrock (eval_bedrock.py). Credentials via standard AWS chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_JUDGE_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
