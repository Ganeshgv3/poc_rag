# Optional: use a single env file from elsewhere (loaded first; poc_rag/.env still overrides if present)
# DOTENV_PATH=/var/www/php83-app/rag/.env

# Deployment environment: development (default) or production.
# In production the app refuses to start unless a secure JWT_SECRET is set.
# APP_ENV=development
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=rag_app
# Generate a strong value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=120
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Per-request timeout (seconds) for Ollama generation/grader calls.
# OLLAMA_TIMEOUT_SECONDS=120

# CORS: comma-separated allowlist of frontend origins. Leave unset/"*" for open
# dev access (credentials disabled). Set explicit origins to allow credentialed requests.
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://app.example.com

# Max PDF upload size in megabytes (rejects larger files with HTTP 413).
# MAX_UPLOAD_MB=25

# Sentence-Transformers embedding model. Changing this re-embeds new uploads;
# existing collections keep their original dimensions, so re-index old PDFs after a change.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Conversation context memory for Ollama (prior user/assistant turns + current RAG message)
# CONTEXT_MEMORY_ENABLED=true
# CONTEXT_MEMORY_MAX_MESSAGES=40

# PDF chunking for indexing (optional tuning)
# PDF_CHUNK_SIZE=1100
# PDF_CHUNK_OVERLAP=180
# Table-heavy PDFs: PyMuPDF table → markdown, row-batched chunks with headers repeated
# PDF_TABLE_EXTRACTION_ENABLED=true
# PDF_TABLE_MAX_ROWS_PER_CHUNK=18

# Vector store: chroma (default) or qdrant
# VECTOR_BACKEND=chroma
# Local Chroma on disk: data/chroma (default when VECTOR_BACKEND unset)
# Optional: remote Chroma server (REST on port 8000 by default — not Qdrant)
# CHROMA_URL=http://127.0.0.1:8000

# Qdrant (REST API / dashboard typically on port 6333)
# VECTOR_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
# Optional: QDRANT_API_KEY=

# Hybrid retrieval (dense embeddings + BM25). Requires rank-bm25.
# HYBRID_SEARCH_ENABLED=true
# HYBRID_RRF_K=60
# HYBRID_DENSE_POOL=24
# HYBRID_SPARSE_POOL=40
# HYBRID_MAX_TOTAL_CHUNKS=12000

# Ranking method for merging dense + sparse lists: rrf | dense | sparse | weighted
# RETRIEVAL_RANKING_METHOD=rrf
# RETRIEVAL_RANKING_DENSE_WEIGHT=0.55
# RETRIEVAL_RANKING_SPARSE_WEIGHT=0.45

# Metadata filtering (Chroma-style where; also applied in-memory for BM25 corpus)
# RETRIEVAL_META_FILTER_ENABLED=true
# Auto sha256 filter is applied per document when chatting via API/Streamlit.
# Optional extra constraints (JSON object), e.g. chunk range:
# RETRIEVAL_META_FILTER={"chunk_index":{"$gte":0,"$lte":50}}

# Optional: LangSmith tracing for LangChain / LangGraph (https://smith.langchain.com)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

# Agentic RAG: after first retrieval, a small LLM pass judges coverage; if weak, 1–2 follow-up
# hybrid searches run and chunks merge (deduped) before answer generation. Extra Ollama call when enabled.
# AGENTIC_RAG_ENABLED=false
# AGENTIC_RAG_MERGED_CAP=12
# AGENTIC_RAG_MAX_FOLLOWUP_QUERIES=2
# AGENTIC_RAG_GRADER_NUM_PREDICT=220

# RAG answer generation (API + LangGraph LLM path). Low temperature improves repeatability for PDF QA.
# RAG_CHAT_TEMPERATURE=0.0
# RAG_CHAT_NUM_PREDICT=320

# HyDE query expansion (optional): generate a hypothetical answer text as an extra retrieval query.
# HYDE_ENABLED=false
# HYDE_NUM_PREDICT=140

# Cross-encoder reranking (optional): rerank retrieved candidates before final context assembly.
# RERANK_ENABLED=false
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_MAX_CANDIDATES=24
# RERANK_DOC_CHAR_LIMIT=1600

# Parent-child retrieval: include neighbor chunks around matched chunk_index in same document.
# PARENT_CHILD_ENABLED=false
# PARENT_CHILD_WINDOW=1
# PARENT_CHILD_CAP=18

# Context compression before generation (keeps high-overlap sentences).
# CONTEXT_COMPRESS_ENABLED=true
# CONTEXT_COMPRESS_MAX_CHARS=1600
